---
import Base from '../layouts/Base.astro';
import EntryCard from './EntryCard.astro';
import { pathForLocale, ui, type Locale } from '../i18n';
import { getResolved, byGroup } from '../lib/entries';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const kind = Astro.url.searchParams.get('kind');
const all = await getResolved(locale);
const entries = kind ? all.filter((e) => e.kind === kind) : all;
const buckets = byGroup(entries);

const kindLabels = {
  project: { zh: '项目', en: 'Projects' },
  note: { zh: '调研笔记', en: 'Research notes' },
  decision: { zh: '决策记录', en: 'Decision records' },
} as const;

const title = kind
  ? locale === 'zh'
    ? kindLabels[kind as keyof typeof kindLabels].zh
    : kindLabels[kind as keyof typeof kindLabels].en
  : locale === 'zh'
    ? '全部条目'
    : 'Everything';

const count = entries.length;
---

<Base locale={locale} title={title}>
  <section class="mx-auto w-full max-w-6xl px-[18px] sm:px-11">
    <div class="py-14 sm:py-20">
      <p class="label">{t.catalog.groupsLabel}</p>
      <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-2">
        <h1 class="text-[2.2rem] leading-tight font-semibold tracking-[-0.038em] sm:text-[3rem]">
          {title}
        </h1>
        <span class="font-mono text-[13px] text-fg-subtle">
          {count} {t.catalog.count}
        </span>
      </div>

      <nav class="mt-8 flex flex-wrap gap-2" aria-label={t.catalog.groupsLabel}>
        {
          (['', 'project', 'note', 'decision'] as const).map((code) => {
            const label =
              code === ''
                ? locale === 'zh'
                  ? '全部'
                  : 'All'
                : locale === 'zh'
                  ? kindLabels[code].zh
                  : kindLabels[code].en;
            const href = code
              ? pathForLocale(`/work/?kind=${code}`, locale)
              : pathForLocale('/work/', locale);
            const active = (kind ?? '') === code;
            return (
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'rounded-[var(--radius-btn)] border px-3.5 py-1.5 text-[14px] transition-colors duration-200',
                  active
                    ? 'border-accent-line bg-accent-panel text-accent'
                    : 'border-line text-fg-muted hover:border-line-strong hover:text-fg',
                ]}
              >
                {label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </section>

  {
    buckets.length === 0 ? (
      <section class="border-t border-line">
        <div class="mx-auto w-full max-w-6xl px-[18px] sm:px-11">
          <p class="py-16 text-[16px] text-fg-subtle">{t.catalog.empty}</p>
        </div>
      </section>
    ) : (
      buckets.map(({ group, items }) => (
        <section class="border-t border-line">
          <div class="mx-auto w-full max-w-6xl px-[18px] sm:px-11">
            <div class="py-14 sm:py-16">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="label text-accent">{group.num}</span>
                <h2 class="text-[1.7rem] leading-tight font-semibold tracking-[-0.028em] sm:text-[2.2rem]">
                  {locale === 'zh' ? group.titleZh : group.titleEn}
                </h2>
                <span class="font-mono text-[12px] text-fg-subtle">{items.length}</span>
              </div>
              <p class="mt-2 max-w-[52ch] text-[16px] text-fg-muted">
                {locale === 'zh' ? group.taglineZh : group.taglineEn}
              </p>

              <div class="mt-8">
                {items.map((item) => (
                  <EntryCard item={item} locale={locale} />
                ))}
              </div>
            </div>
          </div>
        </section>
      ))
    )
  }
</Base>
