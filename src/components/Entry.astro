---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Demo from './Demo.astro';
import { pathForLocale, ui, type Locale } from '../i18n';
import { getResolved, type Resolved } from '../lib/entries';

interface Props {
  item: Resolved;
  locale: Locale;
}

const { item, locale } = Astro.props;
const t = ui[locale];

const all = await getResolved(locale);
const index = all.findIndex((e) => e.slug === item.slug);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const { Content, headings } = await render(item.entry);
const toc = headings.filter((h) => h.depth === 2);

const kindLabels = {
  project: { zh: '项目', en: 'Project' },
  note: { zh: '调研笔记', en: 'Research note' },
  decision: { zh: '决策记录', en: 'Decision' },
}[item.kind];

const dateText = item.date
  ? new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'Asia/Shanghai',
    }).format(item.date)
  : null;

const bodyIsForeign = item.bodyLocale !== locale;
const tocTitle = locale === 'zh' ? '本页目录' : 'On this page';
const measure = locale === 'zh' ? 'max-w-[42em]' : 'max-w-[64ch]';
---

<Base locale={locale} title={item.title} description={item.summary}>
  <article class="mx-auto w-full max-w-6xl px-[18px] sm:px-11">
    <div class="py-12 sm:py-16">
      <nav class="flex items-center gap-2 text-[13px] text-fg-subtle" aria-label="Breadcrumb">
        <a
          href={pathForLocale('/work/', locale)}
          class="transition-colors duration-200 hover:text-fg"
        >
          {t.entry.backToCatalog}
        </a>
        <span aria-hidden="true">/</span>
        {
          item.group && (
            <>
              <span>{locale === 'zh' ? item.group.titleZh : item.group.titleEn}</span>
              <span aria-hidden="true">/</span>
            </>
          )
        }
        <span class="truncate text-fg-muted">{item.title}</span>
      </nav>

      <header class="mt-8">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="label text-accent">{locale === 'zh' ? kindLabels.zh : kindLabels.en}</span>
          {dateText && <span class="label">{dateText}</span>}
          {item.status && <span class="label">· {item.status}</span>}
        </div>

        <h1
          class="mt-4 max-w-[22em] text-[2.1rem] leading-[1.1] font-semibold tracking-[-0.038em] sm:text-[2.8rem]"
          data-pagefind-meta="title"
        >
          {item.title}
        </h1>

        {
          item.summary && (
            <p
              class={`mt-5 ${measure} text-[17px] leading-relaxed text-fg-muted lg:text-[19px]`}
              data-pagefind-meta="description"
            >
              {item.summary}
            </p>
          )
        }

        <div class="mt-6 flex flex-wrap items-center gap-2">
          {
            item.tech.map((tech) => (
              <span class="rounded-[var(--radius-badge)] border border-line px-2 py-0.5 font-mono text-[11px] text-fg-subtle">
                {tech}
              </span>
            ))
          }
          {
            item.repo && (
              <a
                href={item.repo}
                rel="noopener"
                class="rounded-[var(--radius-badge)] border border-accent-line bg-accent-panel px-2 py-0.5 font-mono text-[11px] text-accent transition-colors duration-200 hover:bg-accent"
              >
                {t.actions.viewRepo} ↗
              </a>
            )
          }
        </div>
      </header>

      {
        bodyIsForeign && (
          <p class="mt-8 max-w-[42em] rounded-[var(--radius-card)] border border-line bg-card px-4 py-3 text-[14px] text-fg-muted">
            {locale === 'zh' ? t.entry.originalIsChinese : t.entry.originalIsEnglish}
          </p>
        )
      }
    </div>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start lg:gap-14">
      <div class="min-w-0">
        {
          toc.length > 2 && (
            <details class="mb-10 rounded-[var(--radius-card)] border border-line bg-card px-5 py-4 lg:hidden">
              <summary class="label cursor-pointer list-none">{tocTitle}</summary>
              <ul class="mt-3 space-y-1.5">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="text-[14px] text-fg-muted transition-colors duration-200 hover:text-fg"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        {
          item.entry.data.demo && (
            <Demo
              name={item.entry.data.demo}
              caption={item.entry.data.demoCaption}
            />
          )
        }

        <div class="prose max-w-[68ch] border-t border-line pt-10">
          <Content />
        </div>

        <nav
          class="mt-16 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2"
          aria-label={locale === 'zh' ? '上下篇' : 'Previous and next'}
        >
          {
            prev ? (
              <a
                href={pathForLocale(`/work/${prev.slug}/`, locale)}
                class="bg-card p-5 transition-colors duration-200 hover:bg-card-hover"
              >
                <span class="label">← {locale === 'zh' ? '上一篇' : 'Previous'}</span>
                <p class="mt-2 text-[16px] text-fg">{prev.title}</p>
              </a>
            ) : (
              <div class="bg-card p-5" />
            )
          }
          {
            next ? (
              <a
                href={pathForLocale(`/work/${next.slug}/`, locale)}
                class="bg-card p-5 text-right transition-colors duration-200 hover:bg-card-hover"
              >
                <span class="label">{locale === 'zh' ? '下一篇' : 'Next'} →</span>
                <p class="mt-2 text-[16px] text-fg">{next.title}</p>
              </a>
            ) : (
              <div class="bg-card p-5" />
            )
          }
        </nav>
      </div>

      {
        toc.length > 2 && (
          <aside class="hidden lg:block">
            <nav class="sticky top-24 border-t border-line pt-4" aria-label={tocTitle}>
              <h2 class="label">{tocTitle}</h2>
              <ul class="mt-3 space-y-2">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="block text-[13.5px] leading-snug text-fg-muted transition-colors duration-200 hover:text-fg"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</Base>
