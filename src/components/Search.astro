---
import Base from '../layouts/Base.astro';
import { ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base locale={locale} title={t.actions.search}>
  <section class="mx-auto w-full max-w-3xl px-[18px] sm:px-11">
    <div class="py-14 sm:py-20">
      <p class="label">{t.actions.search}</p>
      <h1 class="mt-3 text-[2.2rem] leading-tight font-semibold tracking-[-0.038em] sm:text-[3rem]">
        {locale === 'zh' ? '搜这个站' : 'Search this site'}
      </h1>

      <form class="mt-8" role="search" id="search-form">
        <label for="search-input" class="sr-only">{t.actions.search}</label>
        <input
          id="search-input"
          type="search"
          name="q"
          autocomplete="off"
          spellcheck="false"
          placeholder={locale === 'zh' ? '输入关键词…' : 'Type to search…'}
          class="w-full rounded-[var(--radius-btn)] border border-line bg-card px-4 py-3 text-[16px] text-fg outline-none transition-colors duration-200 placeholder:text-fg-subtle focus:border-accent"
        />
      </form>

      <p id="search-status" class="mt-4 text-[14px] text-fg-subtle" role="status" aria-live="polite"></p>

      <ul id="search-results" class="mt-6"></ul>

      <noscript>
        <p class="mt-6 text-[15px] text-fg-muted">
          {locale === 'zh'
            ? '搜索需要 JavaScript。没有它的话，请直接浏览「作品」目录。'
            : 'Search needs JavaScript. Without it, browse the catalogue instead.'}
        </p>
      </noscript>
    </div>
  </section>

  <script is:inline define:vars={{ base, locale }}>
    (function () {
      var input = document.getElementById('search-input');
      var status = document.getElementById('search-status');
      var list = document.getElementById('search-results');
      if (!input || !status || !list) return;

      var pagefind;
      function load() {
        if (pagefind) return Promise.resolve(pagefind);
        // pagefind.js is an ES module — it cannot be injected as a classic script.
        return import(base + '/pagefind/pagefind.js').then(function (mod) {
          pagefind = mod;
          return mod;
        });
      }

      function render(results) {
        list.innerHTML = '';
        if (results.length === 0) {
          status.textContent = locale === 'zh' ? '没有结果。' : 'No results.';
          return;
        }
        status.textContent =
          results.length + (locale === 'zh' ? ' 条结果' : (results.length === 1 ? ' result' : ' results'));
        results.slice(0, 20).forEach(function (r) {
          var li = document.createElement('li');
          li.className = 'border-t border-line py-4';
          var a = document.createElement('a');
          a.href = r.url;
          a.className = 'text-[17px] font-medium text-fg hover:text-accent';
          a.textContent = r.meta.title || r.url;
          var p = document.createElement('p');
          p.className = 'mt-1 line-clamp-2 text-[14px] text-fg-muted';
          p.textContent = r.meta.description || r.excerpt || '';
          li.appendChild(a);
          li.appendChild(p);
          list.appendChild(li);
        });
      }

      var timer;
      input.addEventListener('input', function () {
        clearTimeout(timer);
        var q = input.value.trim();
        if (!q) {
          status.textContent = '';
          list.innerHTML = '';
          return;
        }
        status.textContent = locale === 'zh' ? '搜索中…' : 'Searching…';
        timer = setTimeout(function () {
          load()
            .then(function (pf) {
              return pf.search(q, { filters: { language: locale } });
            })
            .then(function (res) {
              return Promise.all(res.results.map(function (r) { return r.data(); }));
            })
            .then(render)
            .catch(function (err) {
              status.textContent =
                locale === 'zh' ? '搜索暂时不可用，请稍后再试。' : 'Search is unavailable right now. Try again in a moment.';
            });
        }, 200);
      });

      if (input.value) input.dispatchEvent(new Event('input'));
    })();
  </script>
</Base>
