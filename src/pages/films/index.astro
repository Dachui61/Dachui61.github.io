---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { pathForLocale, ui } from '../../i18n';

const locale = 'zh';
const t = ui[locale];
const films = (await getCollection('films')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base locale={locale} title={locale === 'zh' ? '短片' : 'Films'}>
  <section class="mx-auto w-full max-w-4xl px-[18px] sm:px-11">
    <div class="py-14 sm:py-20">
      <p class="label">{locale === 'zh' ? '短片' : 'Films'}</p>
      <h1 class="mt-4 text-[2.2rem] leading-tight font-semibold tracking-[-0.038em] sm:text-[3rem]">
        {locale === 'zh' ? '每日热点 · 科普短视频' : 'Daily hot takes, explained'}
      </h1>
      <p class="mt-5 max-w-[52ch] text-[16px] leading-relaxed text-fg-muted">
        {locale === 'zh'
          ? '每天 03:00 自动出片：抓当天的中英热点、查一手资料、写口播稿、配音、合成配乐与音效、画完全部图形，最后过一遍技术验收。画面全部由代码绘制。'
          : 'One episode every day at 03:00: collect the day’s hot topics, verify them against primary sources, write and voice the script, synthesise the score, draw every frame in code, then run a technical acceptance pass.'}
      </p>

      <div class="mt-12">
        {
          films.map((film) => (
            <a
              href={pathForLocale(`/films/${film.data.slug}/`, locale)}
              class="group grid gap-4 border-t border-line py-6 transition-colors duration-200 hover:bg-card sm:grid-cols-[16rem_1fr] sm:gap-8"
            >
              <img
                src={`${base}${film.data.poster}`}
                alt={film.data.title}
                width={1720}
                height={820}
                loading="lazy"
                decoding="async"
                class="w-full rounded-[var(--radius-card)] border border-line"
              />
              <div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="label">
                    {new Intl.DateTimeFormat('zh-CN', {
                      year: 'numeric',
                      month: '2-digit',
                      day: '2-digit',
                      timeZone: 'Asia/Shanghai',
                    }).format(film.data.date)}
                  </span>
                  {film.data.episode && <span class="label">· 第 {film.data.episode} 期</span>}
                  <span class="label">
                    · {film.data.seconds}s · {film.data.resolution}
                  </span>
                </div>
                <h2 class="mt-2 text-[1.15rem] leading-snug font-semibold tracking-[-0.02em] transition-colors duration-200 group-hover:text-accent">
                  {film.data.title}
                </h2>
                <p class="mt-2 max-w-[54ch] text-[15px] leading-relaxed text-fg-muted">
                  {film.data.oneLiner}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
